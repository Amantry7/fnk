# Скопируйте в .env и заполните
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=fnk.bigbee.su,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://fnk.bigbee.su

# --- Почта: уведомления о заявках ---
# Gmail:   smtp.gmail.com 587 TLS (пароль приложения)
# Yandex:  smtp.yandex.ru 465 SSL (пароль приложения)
# Mail.ru: smtp.mail.ru   465 SSL (пароль для внешних приложений)
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=info@example.com
EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=info@example.com
REQUEST_NOTIFY_EMAILS=info@example.com
